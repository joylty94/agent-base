{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh label:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr merge:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git -C:*)",
      "Bash(./scripts/issue-log.sh:*)",
      "Bash(./scripts/setup-labels.sh:*)",
      "Bash(./scripts/plan-to-issues.sh:*)",
      "Bash(./scripts/start-branch.sh:*)",
      "Bash(./scripts/qa-checkout.sh:*)",
      "Bash(./scripts/unblock-dependents.sh:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": ["~/"],
      "allowRead": ["."]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh issue close:*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-close.sh"
          },
          {
            "type": "command",
            "if": "Bash(git*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-branch.sh"
          }
        ]
      }
    ]
  }
}
